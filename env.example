# ============================================================
# NGLAB MOTOR — Variables de entorno
# Copia este fichero a .env y rellena los valores
# NUNCA subas .env a GitHub
# ============================================================

# Google Places API (para buscar negocios en Google Maps)
GOOGLE_PLACES_API_KEY=

# Google PageSpeed API (misma clave que Places si quieres)
PAGESPEED_API_KEY=

# Anthropic (para generar emails con Claude)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=https://jxgdtgjxjqimvrmplxmu.supabase.co
SUPABASE_SERVICE_KEY=

# URL base del servidor (Railway te la da al desplegar)
BASE_URL=http://localhost:8000

# Remitente del email
REMITENTE_NOMBRE=N&G LAB Digital
REMITENTE_EMAIL=hola@nglabdigital.com

# SMTP (para envío directo desde el panel)
SMTP_HOST=smtp.strato.com
SMTP_PORT=587
SMTP_USER=hola@nglabdigital.com
SMTP_PASS=

# Datos legales (pie del email)
EMPRESA_LEGAL=N&G LAB Digital S.L.

# Clave de la API del motor (protege los endpoints)
MOTOR_API_KEY=

# Cuántos emails enviar por día máximo
LOTE_DIARIO=25

# ID de organización en Supabase
ORG_ID=
